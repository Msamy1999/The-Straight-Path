{
  "name": "truth-comparison-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4173",
    "build": "next build",
    "start": "next start -p 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke:test": "node scripts/smoke-test.mjs",
    "verify:drafts": "node payload/verify-drafts-local.mjs && node scripts/verify-quran-coverage.mjs",
    "verify:key-scripture": "node scripts/verify-key-scripture.mjs",
    "verify:offline": "node scripts/verify-service-worker.mjs",
    "verify:editorial-access": "tsx scripts/verify-editorial-access.ts",
    "verify:reader-text": "tsx scripts/verify-reader-text.ts",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:scripture": "node payload/verify-drafts.mjs",
    "verify:quran": "node payload/verify-quran-uthmani.mjs",
    "content:sync": "tsx payload/import-drafts.ts --status=reviewed"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "^16.14.2",
    "lucide-react": "^0.468.0",
    "msedge-tts": "^2.0.7",
    "next": "16.3.8",
    "payload": "3.88.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "esbuild@<=0.24.2": "0.25.12",
    "dompurify": "3.4.16",
    "fast-uri": "3.1.8",
    "brace-expansion@<=1.1.20": "1.1.21",
    "brace-expansion@4.0.0 - 5.0.11": "5.0.12",
    "js-yaml@3.0.0 - 3.15.1": "3.15.2",
    "js-yaml@4.0.0 - 4.3.1": "4.3.2",
    "nanoid@<3.3.18": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "axios": "1.20.0",
    "browserslist": "4.29.3",
    "baseline-browser-mapping": "2.11.27"
  },
  "type": "module"
}
